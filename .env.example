# RivalMap standalone runtime
# Copy to .env for local development. Do not commit real keys.

SEARCH_PROVIDER=exa
EXA_API_KEY=
EXA_SEARCH_TYPE=fast
EXA_TIMEOUT_SECONDS=8
EXA_MAX_RESULTS=6

# Amazon Bedrock through the standard AWS credential chain. Do not store credentials here.
RIVALMAP_AWS_REGION=us-west-2
RIVALMAP_BEDROCK_MODEL_ID=
# Optional per-agent overrides:
RIVALMAP_BEDROCK_FRAMING_MODEL_ID=
RIVALMAP_BEDROCK_ORCHESTRATOR_MODEL_ID=
RIVALMAP_BEDROCK_RESEARCH_MODEL_ID=
RIVALMAP_BEDROCK_INTELLIGENCE_MODEL_ID=
RIVALMAP_BEDROCK_PRESENTATION_MODEL_ID=
# Optional latency/cost tuning by role (defaults shown):
RIVALMAP_BEDROCK_FRAMING_MAX_TOKENS=512
RIVALMAP_BEDROCK_ORCHESTRATOR_MAX_TOKENS=768
RIVALMAP_BEDROCK_RESEARCH_MAX_TOKENS=768
RIVALMAP_BEDROCK_INTELLIGENCE_MAX_TOKENS=1536
RIVALMAP_BEDROCK_PRESENTATION_MAX_TOKENS=768
RIVALMAP_BEDROCK_FRAMING_TEMPERATURE=0
RIVALMAP_BEDROCK_ORCHESTRATOR_TEMPERATURE=0
RIVALMAP_BEDROCK_RESEARCH_TEMPERATURE=0.1
RIVALMAP_BEDROCK_INTELLIGENCE_TEMPERATURE=0.1
RIVALMAP_BEDROCK_PRESENTATION_TEMPERATURE=0.2
RIVALMAP_BEDROCK_CONNECT_TIMEOUT_SECONDS=5
RIVALMAP_BEDROCK_READ_TIMEOUT_SECONDS=60
RIVALMAP_BEDROCK_MAX_ATTEMPTS=3

RIVALMAP_HOST=127.0.0.1
RIVALMAP_PORT=8876
